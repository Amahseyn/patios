    "\"%@ sounds relaxed and comfortable today based on recent activity.\"": {
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«بر اساس فعالیت‌های اخیر، %@ امروز آرام و راحت به نظر می‌رسد.»"
          }
        }
      }
    },
    "\"%@ sounds relaxed and comfortable. This type of sound usually happens during positive interactions.\"": {
